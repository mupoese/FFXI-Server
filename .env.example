# FFXI Server Docker Environment Configuration
# Copy this file to .env and modify the values as needed

# Database Configuration
MYSQL_ROOT_PASSWORD=xiserver_root_2024
MYSQL_DATABASE=xidb
MYSQL_USER=xiuser  
MYSQL_PASSWORD=xiserver_2024

# Cloudflare Tunnel Configuration (Optional)
# Get your tunnel token from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=ffxi-server
CLOUDFLARE_DOMAIN=yourdomain.com

# Server Configuration
FFXI_SERVER_NAME=LandSandBoat Server
FFXI_MAX_PLAYERS=500

# Development/Debug Options
FFXI_DEBUG_MODE=false
FFXI_LOG_LEVEL=INFO

# Network Performance Tuning
FFXI_ENABLE_BONDING=false
FFXI_CONNECTION_POOL_SIZE=20

# Optional Service Profiles
# Uncomment to enable additional services:
# COMPOSE_PROFILES=redis,admin,cloudflare