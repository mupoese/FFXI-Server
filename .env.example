# FFXI Server Docker Environment Configuration
# Copy this file to .env and modify the values as needed

# Database Configuration
MYSQL_ROOT_PASSWORD=xiserver_root_2024
MYSQL_DATABASE=xidb
MYSQL_USER=xiuser  
MYSQL_PASSWORD=xiserver_2024

# Cloudflare Tunnel Configuration (Optional)
# Get your tunnel token from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_NAME=ffxi-server
CLOUDFLARE_DOMAIN=yourdomain.com

# Server Configuration
SERVERNAME=FFXI
FFXI_SERVER_NAME=LandSandBoat Server
FFXI_MAX_PLAYERS=500

# Load Balancer Configuration
HAPROXY_STATS_PASSWORD=haproxy123

# API Configuration
FFXI_API_SECRET_KEY=your_secret_key_here_change_this
FFXI_ADMIN_USERNAME=admin
FFXI_ADMIN_PASSWORD=admin123

# Development/Debug Options
FFXI_DEBUG_MODE=false
FFXI_LOG_LEVEL=INFO

# Network Performance Tuning
FFXI_ENABLE_BONDING=false
FFXI_CONNECTION_POOL_SIZE=20

# Network Bonding Configuration (when FFXI_ENABLE_BONDING=true)
FFXI_BONDING_MODE=balance-xor
FFXI_BONDING_HASH_POLICY=layer3+4
FFXI_BONDING_MII_MON_INTERVAL=100
FFXI_BONDING_FAILOVER_TIMEOUT=5000
FFXI_BONDING_INTERFACES=eth0,eth1
FFXI_BONDING_IP=
FFXI_BONDING_GATEWAY=
FFXI_BONDING_DHCP=yes

# Monitoring Configuration
GRAFANA_PASSWORD=admin123
NETDATA_CLAIM_TOKEN=

# Optional Service Profiles
# Available profiles: redis, admin, cloudflare, multi-instance, high-load, monitoring
# Example: COMPOSE_PROFILES=redis,admin,cloudflare,monitoring
COMPOSE_PROFILES=

# Docker Build Configuration
DOCKER_USERNAME=
DOCKER_PASSWORD=

# Performance Tuning
FFXI_ENABLE_HIGH_PERFORMANCE=true
FFXI_ENABLE_CONNECTION_POOLING=true
FFXI_TCP_NODELAY=true
FFXI_SOCKET_BUFFER_SIZE=65536

# Security Configuration
FFXI_ENABLE_FIREWALL=true
FFXI_RATE_LIMIT_ENABLED=true
FFXI_MAX_CONNECTIONS_PER_IP=50

# Windower/Ashita Compatibility
FFXI_WINDOWER_COMPATIBLE=true
FFXI_ASHITA_COMPATIBLE=true
FFXI_CLIENT_TIMEOUT=30000
FFXI_PACKET_BUFFER_SIZE=8192