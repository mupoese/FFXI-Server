# MySQL Configuration for FFXI Server
# Optimized for high-load scenarios with multiple server instances

[mysqld]
# Basic settings
bind-address = 0.0.0.0
port = 3306
max_connections = 1000
max_connect_errors = 10000

# Character set and collation
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = '+00:00'

# InnoDB settings for performance
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_log_buffer_size = 16M
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
innodb_open_files = 400
innodb_io_capacity = 400
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_thread_concurrency = 16

# Query cache settings
query_cache_type = 1
query_cache_size = 64M
query_cache_limit = 2M

# Thread and connection settings
thread_cache_size = 128
thread_stack = 256K
sort_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 1M
join_buffer_size = 1M

# Table and index settings
table_open_cache = 4000
table_definition_cache = 1400
open_files_limit = 65535

# Temporary table settings
tmp_table_size = 64M
max_heap_table_size = 64M

# Binary logging (for replication if needed)
log_bin = mysql-bin
binlog_format = ROW
expire_logs_days = 7
max_binlog_size = 100M

# Slow query log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# Error log
log_error = /var/log/mysql/error.log

# Performance schema (optional, can be disabled for production)
performance_schema = ON

# Security settings
skip_name_resolve = 1
secure_file_priv = /var/lib/mysql-files/

# Networking settings for FFXI
max_allowed_packet = 64M
net_buffer_length = 16K
wait_timeout = 28800
interactive_timeout = 28800

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4